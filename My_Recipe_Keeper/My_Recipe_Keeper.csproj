<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Android-only, same as Pok_E_List: no iOS/MacCatalyst/Windows heads to build or ship. -->
        <TargetFrameworks>net10.0-android</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <RootNamespace>My_Recipe_Keeper</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance. -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>My Recipe Keeper</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.robowen.my_recipe_keeper</ApplicationId>

        <!-- Versions — ApplicationVersion is bumped by Scripts/IncrementVersion.ps1 after each Release
             Android package (see the targets at the bottom). -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

        <!-- Fast Deploy can leave stale assemblies in the device-side override dir (SIGABRT on launch
             after an interrupted deploy) — same fix as Pok_E_List: full APK each debug deploy. -->
        <AndroidFastDeploymentType Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">None</AndroidFastDeploymentType>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FF7A45" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFF6EC" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
        <!-- Same on-device OCR as Pok_E_List (Google ML Kit on Android): free, offline, no API key. -->
        <PackageReference Include="Plugin.Maui.OCR" Version="1.1.1" />
        <!-- Pinned for the same reason as Pok_E_List: Android native binary hasn't been republished
             past 2.1.13 on the 3.x line yet (GHSA-2m69-gcr7-jv3q). -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\My_Recipe_Keeper.Core\My_Recipe_Keeper.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="appsettings.json" />
    </ItemGroup>

    <!-- Release packaging: rename the signed APK/AAB to My_Recipe_Keeper_<display>_<build>.apk, then bump
         ApplicationVersion for the next release. Bumping *after* packaging (not before) means the
         filename always matches the version actually baked into the package, since MSBuild has already
         evaluated ApplicationVersion by the time any target runs. -->
    <Target Name="RenameReleasePackage" AfterTargets="SignAndroidPackage" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Scripts\RenameAPK.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -ApplicationDisplayVersion &quot;$(ApplicationDisplayVersion)&quot; -ApplicationVersion &quot;$(ApplicationVersion)&quot;" />
    </Target>

    <Target Name="IncrementReleaseVersion" AfterTargets="RenameReleasePackage" Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Scripts\IncrementVersion.ps1&quot; -ProjectPath &quot;$(MSBuildProjectFullPath)&quot;" />
    </Target>

</Project>
